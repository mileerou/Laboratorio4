/*
 * uart_lab04.c
 * Driver USART2 — STM32F446RE — CMSIS puro
 *
 * Pines: PA2 = TX (AF7)   PA3 = RX (AF7)
 * Reloj: APB1 = 16 MHz (HSI por defecto sin PLL)
 *        Si usas PLL ajusta CPU_HZ en el .h o con -DCPU_HZ=84000000
 */

#include "uart_lab04.h"
#include "stm32f4xx.h"

#ifndef CPU_HZ
#define CPU_HZ  16000000UL
#endif

/* BRR = fCK / baud  (sobremuestreo x16, redondeo al entero mas cercano) */
static uint32_t compute_brr(uint32_t baud)
{
    return (CPU_HZ + (baud / 2U)) / baud;
}

/* ------------------------------------------------------------------
 * uart2_init
 *   baud      : 9600 / 19200 / 38400 / 115200
 *   enable_rx : 1 habilita PA3+RE,  0 solo TX
 * ------------------------------------------------------------------ */
void uart2_init(uint32_t baud, uint8_t enable_rx)
{
    /* 1) Habilitar clocks */
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;

    /* Retardo de propagacion del clock (leer el registro lo garantiza) */
    volatile uint32_t tmp = RCC->APB1ENR; (void)tmp;

    /* 2) PA2 → Alternate Function */
    GPIOA->MODER &= ~(3U << (2U * 2U));
    GPIOA->MODER |=  (2U << (2U * 2U));

    /* 3) PA2 → AF7  (AFRL bits [11:8]) */
    GPIOA->AFR[0] &= ~(0xFU << (4U * 2U));
    GPIOA->AFR[0] |=  (7U   << (4U * 2U));

    /* 4) PA3 → AF solo si se habilita RX */
    if (enable_rx)
    {
        GPIOA->MODER &= ~(3U << (3U * 2U));
        GPIOA->MODER |=  (2U << (3U * 2U));

        GPIOA->AFR[0] &= ~(0xFU << (4U * 3U));
        GPIOA->AFR[0] |=  (7U   << (4U * 3U));
    }

    /* 5) Configurar USART2 */
    USART2->CR1 = 0;          /* deshabilitar para configurar */
    USART2->CR2 = 0;          /* 1 stop bit */
    USART2->CR3 = 0;          /* sin flow control */

    USART2->BRR = compute_brr(baud);   /* baud rate */

    /* 8N1 es el default de CR1 tras el reset = 0 */
    USART2->CR1 |= USART_CR1_TE;              /* TX enable */
    if (enable_rx) USART2->CR1 |= USART_CR1_RE;  /* RX enable */
    USART2->CR1 |= USART_CR1_UE;              /* USART enable */
}

/* ------------------------------------------------------------------
 * TX
 * ------------------------------------------------------------------ */
void uart2_write_char(char c)
{
    while ((USART2->SR & USART_SR_TXE) == 0) {}
    USART2->DR = (uint8_t)c;
}

void uart2_write_str(const char *s)
{
    if (!s) return;
    while (*s) uart2_write_char(*s++);
}

void uart2_write_u32(uint32_t v)
{
    char buf[11];
    int  i = 0;
    if (v == 0) { uart2_write_char('0'); return; }
    while (v > 0 && i < 10) { buf[i++] = (char)('0' + (v % 10U)); v /= 10U; }
    while (i--) uart2_write_char(buf[i]);
}

/* ------------------------------------------------------------------
 * RX
 * ------------------------------------------------------------------ */
char uart2_read_char_blocking(void)
{
    while ((USART2->SR & USART_SR_RXNE) == 0) {}
    return (char)(USART2->DR & 0xFFU);
}

/* Redireccion para printf (syscalls arm-none-eabi) */
int __io_putchar(int ch)
{
    uart2_write_char((char)ch);
    return ch;
}
